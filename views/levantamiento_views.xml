<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- =================================================================== -->
    <!-- LEVANTAMIENTO.MEDIDA VIEWS -->
    <!-- =================================================================== -->

    <!-- Form View -->
    <record id="view_levantamiento_medida_form" model="ir.ui.view">
        <field name="name">levantamiento.medida.form</field>
        <field name="model">levantamiento.medida</field>
        <field name="arch" type="xml">
            <form string="Levantamiento de Elementos">
                <header>
                    <!-- Botón imprimir -->
                    <button name="%(action_report_levantamiento_medida)d" type="action"
                            string="Imprimir" class="btn-secondary" icon="fa-print"/>
                </header>

                <sheet>
                    <!-- Botones inteligentes -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_adjuntos" type="object"
                                class="oe_stat_button" icon="fa-paperclip"
                                invisible="attachment_count == 0">
                            <field name="attachment_count" widget="statinfo" string="Adjuntos"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1" class="oe_inline"/>
                            <field name="priority" widget="priority" class="ms-2"/>
                        </h1>
                    </div>

                    <group>
                        <group name="cliente_info" string="Información del Cliente">
                            <field name="cliente_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="sucursal_id"
                                   options="{'no_create_edit': False, 'no_open': False}"
                                   context="{'default_parent_id': cliente_id, 'default_type': 'delivery', 'default_is_company': False}"/>
                            <field name="direccion_trabajo" readonly="1"/>
                        </group>
                        <group name="fechas_responsables" string="Fechas y Responsables">
                            <field name="fecha"/>
                            <field name="responsable_id"/>
                            <field name="fecha_instalacion"/>
                            <field name="instalador_id"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- Pestaña de Elementos -->
                        <page string="Elementos" name="medidas">
                            <field name="linea_ids" widget="one2many">
                                <tree create="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="tipo_elemento_id"/>
                                    <field name="ubicacion"/>
                                    <field name="ancho"/>
                                    <field name="alto"/>
                                    <field name="profundidad" optional="hide"/>
                                    <field name="uom_id"/>
                                    <field name="cantidad"/>
                                    <field name="area_ft2" readonly="1" sum="Total Área"/>
                                    <field name="area_total_ft2" readonly="1" sum="Total"/>
                                    <field name="estado_linea" widget="badge"
                                           decoration-info="estado_linea == 'pendiente'"
                                           decoration-primary="estado_linea == 'medido'"
                                           decoration-success="estado_linea == 'confirmado'"
                                           decoration-warning="estado_linea == 'con_incidencia'"
                                           decoration-danger="estado_linea == 'cancelado'"
                                           optional="show"/>
                                    <field name="log_count" string="Eventos" optional="show"/>
                                    <field name="notas" optional="hide"/>
                                    <button name="action_add_log" type="object"
                                            title="Registrar Evento" icon="fa-plus-circle"
                                            class="btn-link"/>
                                </tree>
                            </field>

                            <div class="text-center mt-3">
                                <button name="action_add_linea_fullscreen" type="object"
                                        string="Agregar Elemento" class="btn-link"/>
                            </div>

                            <group class="oe_subtotal_footer">
                                <field name="linea_count" string="Total de Elementos"/>
                            </group>
                        </page>

                        <page string="Eventos" name="eventos_compartidos">
                            <field name="evento_ids" mode="tree">
                                <tree default_order="fecha desc" create="0">
                                    <field name="fecha"/>
                                    <field name="tipo"/>
                                    <field name="resumen"/>
                                    <field name="estado"/>
                                    <field name="usuario_id" widget="many2one_avatar_user"/>
                                    <field name="linea_ids" widget="many2many_tags" optional="show"/>
                                    <field name="costo_total" sum="Total"
                                           groups="levantamiento_medidas.group_levantamiento_cost_user,levantamiento_medidas.group_levantamiento_manager"/>
                                </tree>
                            </field>

                            <div class="text-center mt-3">
                                <button name="action_add_evento_compartido" type="object"
                                        string="+ Agregar Evento" class="btn-link"/>
                            </div>
                        </page>

                        <!-- Pestaña de Notas -->
                        <page string="Notas e Incidencias" name="notas">
                            <group>
                                <field name="notas_levantamiento"
                                       placeholder="Notas del levantamiento de medidas..."/>
                            </group>
                            <group>
                                <field name="notas_instalacion"
                                       placeholder="Notas de la instalación..."/>
                            </group>
                            <group>
                                <field name="incidencias"
                                       placeholder="Incidencias encontradas durante la instalación..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_levantamiento_medida_tree" model="ir.ui.view">
        <field name="name">levantamiento.medida.tree</field>
        <field name="model">levantamiento.medida</field>
        <field name="arch" type="xml">
            <tree string="Levantamientos de Elementos" multi_edit="1">
                <field name="name"/>
                <field name="cliente_id"/>
                <field name="sucursal_id" optional="show"/>
                <field name="fecha"/>
                <field name="responsable_id" widget="many2one_avatar_user"/>
                <field name="linea_count" string="Elementos"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_levantamiento_medida_kanban" model="ir.ui.view">
        <field name="name">levantamiento.medida.kanban</field>
        <field name="model">levantamiento.medida</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column"
                    on_create="quick_create" quick_create_view="levantamiento_medidas.view_levantamiento_medida_form_quick_create"
                    records_draggable="true" group_delete="false" group_create="false">
                <field name="id"/>
                <field name="name"/>
                <field name="cliente_id"/>
                <field name="sucursal_id"/>
                <field name="fecha"/>
                <field name="responsable_id"/>
                <field name="linea_count"/>
                <field name="attachment_count"/>
                <field name="color"/>
                <field name="priority"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click #{!selection_mode ? 'p-2' : ''}">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="o_kanban_record_subtitle mb-1">
                                <field name="cliente_id"/>
                            </div>
                            <div t-if="record.sucursal_id.value" class="text-muted small mb-1">
                                <i class="fa fa-map-marker me-1"/>
                                <field name="sucursal_id"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <div class="text-muted small">
                                    <i class="fa fa-calendar me-1"/>
                                    <field name="fecha"/>
                                </div>
                                <div class="d-flex gap-1">
                                    <span t-if="record.linea_count.raw_value" class="badge text-bg-secondary">
                                        <i class="fa fa-ruler me-1"/>
                                        <field name="linea_count"/>
                                    </span>
                                    <span t-if="record.attachment_count.raw_value" class="badge text-bg-secondary">
                                        <i class="fa fa-paperclip me-1"/>
                                        <field name="attachment_count"/>
                                    </span>
                                </div>
                            </div>
                            <div class="d-flex justify-content-end mt-2">
                                <field name="responsable_id" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Quick Create Form for Kanban -->
    <record id="view_levantamiento_medida_form_quick_create" model="ir.ui.view">
        <field name="name">levantamiento.medida.form.quick_create</field>
        <field name="model">levantamiento.medida</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="cliente_id" options="{'no_create': True}"/>
                    <field name="sucursal_id" options="{'no_create': True}"/>
                    <field name="fecha"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_levantamiento_medida_search" model="ir.ui.view">
        <field name="name">levantamiento.medida.search</field>
        <field name="model">levantamiento.medida</field>
        <field name="arch" type="xml">
            <search string="Buscar Levantamientos">
                <field name="name"/>
                <field name="cliente_id"/>
                <field name="sucursal_id"/>
                <field name="responsable_id"/>
                <separator/>
                <filter name="filter_my" string="Mis Levantamientos"
                        domain="[('responsable_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_this_month" string="Este Mes"
                        domain="[('fecha', '>=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('fecha', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_this_year" string="Este Año"
                        domain="[('fecha', '>=', (context_today() - relativedelta(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_cliente" string="Cliente"
                            context="{'group_by': 'cliente_id'}"/>
                    <filter name="group_by_sucursal" string="Sucursal"
                            context="{'group_by': 'sucursal_id'}"/>
                    <filter name="group_by_responsable" string="Responsable"
                            context="{'group_by': 'responsable_id'}"/>
                    <filter name="group_by_fecha" string="Fecha"
                            context="{'group_by': 'fecha:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- LEVANTAMIENTO.LINEA VIEWS -->
    <!-- =================================================================== -->

    <!-- Form View for Lines -->
    <record id="view_levantamiento_linea_form" model="ir.ui.view">
        <field name="name">levantamiento.linea.form</field>
        <field name="model">levantamiento.linea</field>
        <field name="arch" type="xml">
            <form string="Elemento">
                <sheet>
                    <group>
                        <group>
                            <field name="levantamiento_id" invisible="1"/>
                            <field name="tipo_elemento_id" options="{'no_open': True}"/>
                            <field name="ubicacion"/>
                        </group>
                        <group>
                            <field name="image_1920" widget="image" class="oe_avatar"/>
                        </group>
                    </group>
                    <group string="Dimensiones">
                        <group>
                            <field name="uom_id" options="{'no_create': True}"/>
                            <field name="ancho"/>
                            <field name="alto"/>
                            <field name="profundidad"/>
                        </group>
                        <group string="Conversión">
                            <field name="conversion_uom_id" options="{'no_create': True}"/>
                            <field name="ancho_m" readonly="1"/>
                            <field name="alto_m" readonly="1"/>
                            <field name="profundidad_m" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="cantidad"/>
                    </group>
                    <group string="Área">
                        <field name="area_ft2" readonly="1"/>
                        <field name="area_total_ft2" readonly="1"/>
                    </group>
                    <group>
                        <field name="notas"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View for Lines -->
    <record id="view_levantamiento_linea_tree" model="ir.ui.view">
        <field name="name">levantamiento.linea.tree</field>
        <field name="model">levantamiento.linea</field>
        <field name="arch" type="xml">
            <tree string="Elementos">
                <field name="levantamiento_id"/>
                <field name="cliente_id"/>
                <field name="fecha"/>
                <field name="tipo_elemento_id"/>
                <field name="ubicacion"/>
                <field name="ancho"/>
                <field name="alto"/>
                <field name="uom_id"/>
                <field name="area_ft2"/>
                <field name="cantidad"/>
                <field name="estado_linea" widget="badge"
                       decoration-info="estado_linea == 'pendiente'"
                       decoration-primary="estado_linea == 'medido'"
                       decoration-success="estado_linea == 'confirmado'"
                       decoration-warning="estado_linea == 'con_incidencia'"
                       decoration-danger="estado_linea == 'cancelado'"/>
                <field name="log_count" string="Eventos"/>
            </tree>
        </field>
    </record>

    <!-- Search View for Lines -->
    <record id="view_levantamiento_linea_search" model="ir.ui.view">
        <field name="name">levantamiento.linea.search</field>
        <field name="model">levantamiento.linea</field>
        <field name="arch" type="xml">
            <search string="Buscar Elementos">
                <field name="tipo_elemento_id"/>
                <field name="ubicacion"/>
                <field name="levantamiento_id"/>
                <field name="cliente_id"/>
                <separator/>
                <filter name="filter_pendiente" string="Pendientes"
                        domain="[('estado_linea', '=', 'pendiente')]"/>
                <filter name="filter_medido" string="Medidos"
                        domain="[('estado_linea', '=', 'medido')]"/>
                <filter name="filter_confirmado" string="Confirmados"
                        domain="[('estado_linea', '=', 'confirmado')]"/>
                <filter name="filter_con_incidencia" string="Con Incidencia"
                        domain="[('estado_linea', '=', 'con_incidencia')]"/>
                <filter name="filter_cancelado" string="Cancelados"
                        domain="[('estado_linea', '=', 'cancelado')]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_cliente" string="Cliente" context="{'group_by': 'cliente_id'}"/>
                    <filter name="group_tipo" string="Tipo Elemento" context="{'group_by': 'tipo_elemento_id'}"/>
                    <filter name="group_estado" string="Estado" context="{'group_by': 'estado_linea'}"/>
                    <filter name="group_levantamiento" string="Levantamiento" context="{'group_by': 'levantamiento_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Lines -->
    <record id="action_levantamiento_linea" model="ir.actions.act_window">
        <field name="name">Elementos Medidos</field>
        <field name="res_model">levantamiento.linea</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_levantamiento_linea_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay elementos medidos
            </p>
        </field>
    </record>

    <!-- =================================================================== -->
    <!-- ACTIONS -->
    <!-- =================================================================== -->

    <!-- Main Action for Levantamientos -->
    <record id="action_levantamiento_medida" model="ir.actions.act_window">
        <field name="name">Levantamientos de Elementos</field>
        <field name="res_model">levantamiento.medida</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_levantamiento_medida_search"/>
        <field name="context">{'search_default_filter_my': 1}</field>
        <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear un nuevo levantamiento de elementos
                </p>
                <p>
                    Registre los elementos levantados en las sucursales de sus clientes
                    para trabajos de rotulación, vallas, cristales y más.
                </p>
        </field>
    </record>

    <!-- Action for Lines -->
    <record id="action_levantamiento_linea" model="ir.actions.act_window">
        <field name="name">Todos los Elementos</field>
        <field name="res_model">levantamiento.linea</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
                <p class="o_view_nocontent_neutral_face">
                    No hay elementos registrados.
                </p>
            </field>
    </record>

    <!-- =================================================================== -->
    <!-- MENUS -->
    <!-- =================================================================== -->

    <!-- Root Menu -->
    <menuitem id="menu_levantamiento_root"
              name="Levantamientos"
              sequence="45"
              web_icon="levantamiento_medidas,static/description/icon.png"
              groups="levantamiento_medidas.group_levantamiento_user"/>

    <!-- Submenu Levantamientos -->
    <menuitem id="menu_levantamiento_medidas"
              name="Levantamientos"
              parent="menu_levantamiento_root"
              sequence="10"/>

    <menuitem id="menu_levantamiento_medida_all"
              name="Levantamientos de Elementos"
              parent="menu_levantamiento_medidas"
              action="action_levantamiento_medida"
              sequence="10"/>

    <menuitem id="menu_levantamiento_linea_all"
              name="Elementos Medidos"
              parent="menu_levantamiento_medidas"
              action="action_levantamiento_linea"
              sequence="20"/>

    <menuitem id="menu_levantamiento_log_all"
              name="Historial de Eventos"
              parent="menu_levantamiento_medidas"
              action="action_levantamiento_linea_log"
              sequence="25"/>

</odoo>
